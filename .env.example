# Copy to .env and fill in. Never commit real credentials.

# API
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=True
LOG_LEVEL=INFO

# Service-to-service key (ASP.NET Core → this FastAPI service)
APPLICATION_AUTH_API_KEY=replace-me

# Identity headers are supplied by the .NET API (this service does not own auth)
# X-User-Id, X-User-Roles (comma-separated: Admin,Analyst,Viewer)

# SQL Server
DB_SERVER=localhost\\SQLEXPRESS
DB_NAME=PeaceEnablerDB
DB_USE_WINDOWS_AUTH=True
DB_USERNAME=
DB_PASSWORD=
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# Vector store (Chroma)
VECTOR_PERSIST_PATH=./chroma_store
VECTOR_COLLECTION_PREFIX=pem

# Graph DB (Phase 2 — unused in Phase 1)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# LLM keys — never hardcode in source
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Local / degraded-mode model (Phase 5 fallback; optional in Phase 1)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3
